# Where screenshots are written (relative to the backend working directory)
SCREENSHOT_DIR=./screenshots
# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000
# Playwright timing (milliseconds)
NAVIGATION_TIMEOUT_MS=30000
NETWORK_IDLE_TIMEOUT_MS=5000
SETTLE_DELAY_MS=500
# How many preview jobs may capture at the same time
MAX_CONCURRENT_JOBS=2
# Full-page screenshots taller than this (px) are clipped
MAX_FULL_PAGE_HEIGHT=10000
# Extra hostnames to refuse (comma-separated); localhost-style names are always refused
BLOCKED_HOSTNAMES=metadata.google.internal
